{
  "name": "finance-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd site && astro dev",
    "build": "cd site && astro build",
    "preview": "cd site && astro preview",
    "test": "vitest run",
    "typecheck": "npm run -s worker:types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "check:site": "node scripts/site-check.mjs",
    "sim": "vitest run tests/dscr.sim.test.ts --silent=false",
    "rules-doc": "node scripts/rules-doc.mjs",
    "pack-skills": "node portable/pack.mjs",
    "cost": "node .claude/skills/lessons/scripts/session-cost.mjs",
    "verify": "node scripts/verify.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:types": "wrangler types -c worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:build": "wrangler deploy --dry-run --outdir worker/dist -c worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "1.56.1",
    "read-excel-file": "^9.3.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
