---
/**
 * Page shell: head (no-flash theme), header with the theme toggle, footer. Logic stays in .ts files (D-TECH-05).
 * `look="new"` is the look of D-UX-66 (AG1, docs/DESIGN.md, "The forbidden list"): the top bar links every tool and hides
 * while reading down, the page runs wide, and the footer lists the tools above the name. The DSCR and CMA pages take it
 * in UX3, the estimate and the report in UX4; the notice of what is new shows on home alone.
 */
import './global.css';
import ThemeToggle from './ThemeToggle.astro';
import Arrow from './home/Arrow.astro';
import { THEME_BOOT } from './theme';
import Policies from './Policies.astro';
import { COUNTING, READY, SITE_NAME, pageTitle } from './site';

interface Props { name?: string; description: string; look?: 'new' }
const { name, description, look } = Astro.props;
const fresh = look === 'new';
const here = Astro.url.pathname;
// The menu marks the page it is on (UX9, review finding 12).
const on = (href: string) => (here.startsWith(href) ? ('page' as const) : undefined);
const counting = COUNTING;
// The new look's motion waits for this mark, so a page without scripts, or under reduced motion, shows everything still.
const MOTION_BOOT = "matchMedia('(prefers-reduced-motion: reduce)').matches||document.documentElement.classList.add('js')";
const PRIVACY = 'Figures you type are worked out in your browser and are not sent to us.';
const COUNTED = 'We count which steps are used (the page, which fields change by name, downloads, errors), never what you type, to make the tools better. No cookies.';
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle(name)}</title>
    <meta name="description" content={description} />
    <!-- A shared link (WhatsApp, a message) shows the title and the line under it (REV1); og:url waits on the domain. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle(name)} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={THEME_BOOT}></script>
    {fresh && <script is:inline set:html={MOTION_BOOT}></script>}
    {fresh && <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />}
    {fresh && <link rel="preload" href="/fonts/anek-latin.woff2" as="font" type="font/woff2" crossorigin />}
  </head>
  <body class="min-h-dvh bg-canvas text-ink antialiased" data-look={look}>
    <a href="#main" class={`sr-only px-3 py-2 focus:not-sr-only ${fresh ? 'focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2.5 rounded-full bg-ink text-canvas' : 'focus:absolute focus:top-2 focus:left-2 rounded-control bg-accent text-on-accent'}`}>Skip to content</a>
    {fresh ? (<>
      <header data-header class="sticky top-0 z-40 bg-canvas">
        <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3 sm:px-8">
          <a href="/" class="min-w-0 truncate text-xl font-semibold tracking-tight text-ink">{SITE_NAME}</a>
          <nav aria-label="Tools" class="hidden flex-1 gap-1 lg:flex">
            {READY.map((t) => <a href={t.href} aria-current={on(t.href)} class={`rounded-full px-3 py-2 text-sm hover:bg-surface hover:text-ink ${on(t.href) ? 'font-semibold text-ink underline decoration-2 underline-offset-8' : 'font-medium text-ink-muted'}`}>{t.short}</a>)}
          </nav>
          <div class="ml-auto flex items-center gap-2">
            <ThemeToggle tall />
            {/* On home only: on a tool page the one filled pill is its Download PDF (DESIGN-SITE, Buttons; UX5b), and another
                tool's page is not the place to send to the DSCR (UX9, review finding 12). */}
            {here === '/' && <a href="/dscr/" data-pill class="hidden min-h-11 items-center rounded-full bg-ink px-5 text-sm font-medium text-canvas hover:bg-ink/85 sm:inline-flex">Start a DSCR statement</a>}
          </div>
        </div>
        <nav aria-label="Tools" class="flex flex-wrap justify-center gap-1 px-2 pt-1 pb-2 lg:hidden">
          {READY.map((t) => <a href={t.href} aria-current={on(t.href)} class={`rounded-full px-2.5 py-2 text-sm hover:bg-surface hover:text-ink ${on(t.href) ? 'font-semibold text-ink underline decoration-2 underline-offset-8' : 'font-medium text-ink-muted'}`}>{t.short}</a>)}
        </nav>
      </header>
      {here === '/' && <p class="border-y border-line bg-surface px-4 py-2 text-center text-sm text-ink" data-news>
        <span class="mr-2 rounded-full bg-ink px-2 py-0.5 text-sm font-semibold text-canvas">New</span>
        CMA data: the bank's forms I to VI from five years' figures.
        <a href="/cma/" class="ml-1 font-medium whitespace-nowrap text-ink underline underline-offset-4">Open it <Arrow /></a>
      </p>}
    </>) : (
      <header class="border-b border-line">
        <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
          <a href="/" class="min-w-0 truncate font-semibold text-ink">{SITE_NAME}</a>
          <ThemeToggle />
        </div>
      </header>
    )}
    <main id="main" class={fresh ? 'overflow-x-clip' : 'mx-auto max-w-3xl px-4 py-8'}><slot /></main>
    {fresh ? (
      <footer class="mx-auto max-w-7xl px-4 pt-16 sm:px-8">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <p class="font-heading text-title text-ink lg:col-span-2">Loan papers, worked out.</p>
          <div>
            <p class="text-sm font-medium text-ink-muted">Tools</p>
            <ul class="mt-3 space-y-2">{READY.map((t) => <li><a href={t.href} class="text-sm font-medium text-ink hover:text-link">{t.name}</a></li>)}</ul>
          </div>
          <div>
            <p class="text-sm font-medium text-ink-muted">Your figures</p>
            <p class="mt-3 max-w-prose text-sm text-ink">{PRIVACY}{counting && <span data-testid="counted"> {COUNTED}</span>}</p>
          </div>
        </div>
        {/* Home's name is large; a tool page's foot keeps it small, so the frame never outweighs the figures (UX8, review finding 9). */}
        <p aria-hidden="true" data-wordmark data-settle class={`overflow-hidden text-ink select-none ${here === '/' ? 'mt-16 text-wordmark' : 'mt-10 text-section'}`}>{[...SITE_NAME].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</p>
        <div data-ledger aria-hidden="true"></div>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-6">
          <p class="text-sm text-ink-muted">{SITE_NAME} · {new Date().getFullYear()}</p>
          <Policies />
        </div>
      </footer>
    ) : (
      <footer class="mx-auto max-w-3xl border-t border-line px-4 py-6 text-sm text-ink-muted">
        {PRIVACY}
        {counting && <span data-testid="counted"> {COUNTED}</span>}
        <Policies />
      </footer>
    )}
    <script>import { start } from './events'; import { look } from './look'; import { themeToggles } from './theme'; start(); themeToggles(); look();</script>
  </body>
</html>
