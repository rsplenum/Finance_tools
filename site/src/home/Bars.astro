---
/**
 * The story's bars (AG1): each year's DSCR as the engine gave it, its figure on the bar's end and the target's line labelled
 * at its own end (principle 5 of docs/DESIGN.md). A year under the target is `bad`, one over it `good`; the verdict says so
 * in words; a bar taller than the scale is cut, with a gap near its top. `at` is the story's step that shows it (home.ts).
 */
import type { StoryFrame } from './story';
interface Props { frame: StoryFrame; target: string; scale: number; at: number; title: string }
const { frame, target, scale, at, title } = Astro.props;
const pct = (n: number) => `${Math.min(100, (n / scale) * 100).toFixed(2)}%`;
---
<figure data-at={at} class="mt-10 first:mt-0">
  <figcaption class="text-sm font-medium text-ink-muted">{title}<span class="sr-only">; the target for the lowest year is {target}</span></figcaption>
  <div class="relative mt-4 flex h-52 pr-12 sm:h-60 sm:pr-16">
    <ol class="flex h-full flex-1 items-end gap-1.5 sm:gap-3">
      {frame.years.map((y, i) => (
        <li class="flex h-full flex-1 flex-col items-center justify-end">
          <span class="sr-only">{y.fy}:</span>
          <span class="text-xs font-semibold text-ink tabular-nums">{y.dscr}</span>
          <span data-bar style={`height:${pct(y.n)};--i:${i}`} class={`mt-1 block w-full rounded-t-md ${y.meets ? 'bg-good' : 'bg-bad'}`}>{y.n > scale && <span class="mt-3 block h-1 bg-surface"></span>}</span>
        </li>
      ))}
    </ol>
    <div aria-hidden="true" class="absolute inset-x-0 border-t-2 border-dashed border-ink" style={`bottom:${pct(Number(target))}`}>
      <span class="absolute right-0 bottom-1 text-right text-xs leading-tight font-medium text-ink">Target<br />{target}</span>
    </div>
  </div>
  <ol aria-hidden="true" class="mt-2 flex gap-1.5 pr-12 sm:gap-3 sm:pr-16">
    {frame.years.map((y) => <li class="flex-1 text-center text-xs text-ink-muted tabular-nums">{y.fy.slice(2)}</li>)}
  </ol>
</figure>
