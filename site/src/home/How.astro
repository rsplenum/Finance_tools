---
/**
 * The hero's "how it works" (HOME1b, D-UX-115; docs/DESIGN-MOTION.md): your answers, worked out on this device with
 * nothing sent, four papers for the lender. It says the one thing no other part of home says, that the figures stay here
 * (lesson 11; the audit's §6), and names no tool, since the blocks below do. A picture with no links: the screen reader
 * reads the sentence beside it. home.ts plays it once on each visit (the boxes settle, the lines draw, one marigold pulse
 * runs from your answers to the papers); without scripts or under reduced motion it stands drawn. Across from lg, down
 * below it and under 200 px tall. The lines carry pathLength="1" and no vector-effect (GOTCHAS, AG3). The two pale boxes
 * carry an ink-muted edge, 3:1 against the page.
 */
const LINE = 'fill-none stroke-ink-muted';
const BOX = 'fill-surface stroke-ink-muted';
const DRAW = { pathLength: '1', 'stroke-dasharray': '1', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', class: LINE };
const TEXT = { 'text-anchor': 'middle', 'dominant-baseline': 'central', 'font-weight': '500' };
---
<div data-how class="mt-14 w-full sm:mt-16">
  <p class="sr-only">How it works: what you type is worked out on this device and nothing is sent; it becomes four papers for the lender.</p>
  <svg aria-hidden="true" viewBox="0 0 1000 100" width="1000" height="100" class="mx-auto hidden h-auto max-w-full lg:block">
    <circle data-pulse cx="212" cy="50" r="6" class="fill-marigold" opacity="0" data-to="536,0"></circle>
    <g data-box><rect x="1" y="22" width="200" height="56" rx="20" stroke-width="1.5" class={BOX}></rect><text x="101" y="50" font-size="18" {...TEXT} class="fill-ink">Your answers</text></g>
    <path data-draw d="M212 50 H292" {...DRAW}></path>
    <path data-draw d="M280 40 L292 50 L280 60" {...DRAW}></path>
    <g data-box><rect x="304" y="10" width="352" height="80" rx="20" class="fill-desk"></rect><text x="480" y="38" font-size="18" {...TEXT} class="fill-on-desk">Worked out on this device</text><text x="480" y="64" font-size="16" {...TEXT} class="fill-on-desk-muted">nothing is sent</text></g>
    <path data-draw d="M668 50 H748" {...DRAW}></path>
    <path data-draw d="M736 40 L748 50 L736 60" {...DRAW}></path>
    <g data-box><rect x="760" y="22" width="239" height="56" rx="20" stroke-width="1.5" class={BOX}></rect><text x="879.5" y="50" font-size="17" {...TEXT} class="fill-ink">Four papers for the lender</text></g>
  </svg>
  <svg aria-hidden="true" viewBox="0 0 320 192" width="320" height="192" class="mx-auto h-auto max-w-full lg:hidden">
    <circle data-pulse cx="160" cy="44" r="6" class="fill-marigold" opacity="0" data-to="0,110"></circle>
    <g data-box><rect x="41" y="1" width="238" height="37" rx="18" stroke-width="1.5" class={BOX}></rect><text x="160" y="19.5" font-size="16" {...TEXT} class="fill-ink">Your answers</text></g>
    <path data-draw d="M160 44 V62" {...DRAW}></path>
    <path data-draw d="M152 54 L160 62 L168 54" {...DRAW}></path>
    <g data-box><rect x="20" y="68" width="280" height="56" rx="20" class="fill-desk"></rect><text x="160" y="86" font-size="16" {...TEXT} class="fill-on-desk">Worked out on this device</text><text x="160" y="107" font-size="14" {...TEXT} class="fill-on-desk-muted">nothing is sent</text></g>
    <path data-draw d="M160 130 V148" {...DRAW}></path>
    <path data-draw d="M152 140 L160 148 L168 140" {...DRAW}></path>
    <g data-box><rect x="41" y="154" width="238" height="37" rx="18" stroke-width="1.5" class={BOX}></rect><text x="160" y="172.5" font-size="16" {...TEXT} class="fill-ink">Four papers for the lender</text></g>
  </svg>
</div>
