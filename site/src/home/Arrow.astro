---
/** The arrow after a link's words, drawn: neither Figtree nor Anek carries U+2192, so a typed one falls back to the system font. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={`inline-block ${cls}`} style="width:0.8em;height:0.8em;vertical-align:-0.05em"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
