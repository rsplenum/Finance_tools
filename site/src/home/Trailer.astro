---
/**
 * A story's trailer on its scratch paper (AG3, D-UX-77): a ruled sheet on the ink desk, its double margin rule in red;
 * the pen (pen.ts) writes each `hand` line letter by letter, a typeset card cuts in between, and the marigold marker
 * swipes the result (home.ts, `trailer`). Each line's words are in the page as text; its strokes are a picture of them,
 * standing finished without scripts or under reduced motion.
 */
import { write, PEN } from './pen';
import type { Trailer } from './story';
interface Props { trailer: Trailer }
const { trailer } = Astro.props;
// The pen's size, in ems of the page's type to the pen's em, and its line in the pen's units (PEN.EM to the em).
const SIZE = { title: 2, hand: 1.4 }, STROKE = { title: 5.6, hand: 6.4 }, PAD = 6;
const lines = trailer.lines.map((l) => {
  if (l.kind === 'card') return { ...l };
  const pen = write(l.text), from = l.mark ? l.text.lastIndexOf(l.mark) : -1;
  const box = { x: -PAD, y: pen.top - PAD, w: pen.w + 2 * PAD, h: pen.bottom - pen.top + 2 * PAD };
  const mark = from < 0 ? undefined : { x: pen.x[from] - 3, w: pen.x[from + l.mark!.length] - pen.x[from] + 2, y: PEN.BASE - PEN.CAP - 8, h: PEN.CAP + 14 };
  return { ...l, pen, box, mark };
});
---
<article data-paper data-trailer={trailer.id} class="relative mx-auto max-w-xl rounded-card bg-paper py-8 pr-6 pl-14 text-on-paper shadow-paper sm:py-10 sm:pr-10 sm:pl-20">
  {lines.map((l) => l.kind === 'card' ? (
    <p data-beat="card" class="caps mt-6 text-paper-muted">{l.text}</p>
  ) : (
    <p data-beat={l.kind} class={`border-b border-on-paper/10 ${l.kind === 'title' ? 'pb-3' : 'py-2'}`}>
      <span class="sr-only">{l.text}</span>
      <svg aria-hidden="true" viewBox={`${l.box!.x} ${l.box!.y} ${l.box!.w} ${l.box!.h}`} style={`width:${(l.box!.w / PEN.EM * SIZE[l.kind]).toFixed(2)}em`}
        class="block h-auto max-w-full" fill="none" stroke="currentColor" stroke-width={STROKE[l.kind]} stroke-linecap="round" stroke-linejoin="round">
        {l.mark && <rect data-mark x={l.mark.x} y={l.mark.y} width={l.mark.w} height={l.mark.h} rx="4" fill="var(--marigold)" stroke="none" />}
        {l.pen!.strokes.map((s) => <path d={s.d} />)}
      </svg>
    </p>
  ))}
</article>
