---
/**
 * A story's trailer on its scratch paper (AG3, D-UX-77; AG3b, D-UX-78): a ruled sheet on the ink desk, its double margin
 * rule in red; the pen (pen.ts, sheet.ts) writes each `hand` line letter by letter, a typeset card cuts in between, and
 * the marigold marker swipes the result (home.ts, `trailer`). Each line's words are in the page as text; its strokes are a
 * picture of them, standing finished without scripts or under reduced motion. A `lazy` trailer's strokes come as the
 * reader nears it (`data-src`); until then, and if they never come, its words stand in their place in type.
 */
import { holdsOf, svgsOf } from './sheet';
import type { Trailer } from './story';
interface Props { trailer: Trailer; lazy?: boolean }
const { trailer, lazy = false } = Astro.props;
const svgs = lazy ? [] : svgsOf(trailer), holds = lazy ? holdsOf(trailer) : [];
---
<article data-paper data-trailer={trailer.id} data-src={lazy ? `/trailers/${trailer.id}.json` : undefined}
  class="relative mx-auto max-w-xl rounded-card bg-paper py-8 pr-6 pl-14 text-on-paper shadow-paper sm:py-10 sm:pr-10 sm:pl-20">
  {trailer.lines.map((l, i) => l.kind === 'card' ? (
    <p data-beat="card" class="caps mt-6 text-paper-muted">{l.text}</p>
  ) : (
    <p data-beat={l.kind} class={`border-b border-on-paper/10 ${l.kind === 'title' ? 'pb-3' : 'py-2'}`}>
      <span class={lazy ? (l.kind === 'title' ? 'block text-title' : 'block text-lead') : 'sr-only'} style={holds[i]}>{l.text}</span>
      {!lazy && <Fragment set:html={svgs[i]} />}
    </p>
  ))}
</article>
