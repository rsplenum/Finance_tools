---
/** The policy pages in every footer (LEGAL1, D-BIZ-07); the site check holds each built page to all five. Three a row on
 * a phone, so none is left alone; the page it is on marked as the top bar marks its own. */
import { POLICIES } from './site';

const here = Astro.url.pathname;
const on = (href: string) => (here.startsWith(href) ? ('page' as const) : undefined);
---
<nav aria-label="Policies" data-policies><ul class="grid grid-cols-3 gap-x-4 gap-y-1 sm:flex sm:flex-wrap">{POLICIES.map((p) => <li><a href={p.href} aria-current={on(p.href)} class={`inline-flex min-h-6 items-center text-sm ${on(p.href) ? 'font-semibold text-ink' : 'text-ink-muted hover:text-ink'}`}>{p.name}</a></li>)}</ul></nav>
