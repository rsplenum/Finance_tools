---
import Policy from '../Policy.astro';
import { FIRM, GRIEVANCE_OFFICER } from '../site';
const sections = [
  { h: 'Write to us', p: [
    'Email {email} about the site, a figure that looks wrong, your data or these policies.',
    'For a figure that looks wrong, tell us the tool, what you typed and what you expected. Leave out names, account numbers and anything else that says who you are: we do not need them.',
  ] },
  { h: 'Complaints', p: [
    `Our grievance officer, ${GRIEVANCE_OFFICER}, answers complaints about your data, a payment or these policies, at the same email address.`,
  ] },
  { h: 'Who runs FinSight', p: [
    `${FIRM.name}, ${FIRM.kind}, ${FIRM.town}.`,
  ] },
  { h: 'What we cannot do', p: [
    'We cannot tell you whether a lender will sanction your loan, or advise on a particular loan. We never ask for passwords, OTPs or bank details.',
  ] },
];
---
<Policy title="Contact" description="How to reach FinSight about the site, a figure, your data or its policies." lead="Write to us about the site, a figure that looks wrong, your data or these policies." sections={sections} />
