---
import Base from '../Base.astro';
import ToolHead from '../ToolHead.astro';
import { CmaCalculator } from '../cma/Cma';
---
<Base name="CMA data" description="CMA data for a working-capital limit: the borrower's profit and loss and balance sheets typed in, Forms I to VI, the ratios and the limit by the turnover method." look="new">
  <div data-tool class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16 lg:max-w-7xl">
  <ToolHead href="/cma/" kind="Forms for a working-capital limit" title="CMA data" lead="The CMA (credit monitoring arrangement) data a bank asks for with a working-capital limit, as PDF and Excel. Keep five years’ accounts at hand: three audited, this year’s and next year’s." />
  <div class="mt-2"><CmaCalculator client:load /></div>
  </div>
</Base>
