---
import Base from '../Base.astro';
import { EstimateCalculator } from '../estimate/Estimate';
---
<Base name="Construction or renovation estimate" description="An item-wise estimate of cost for a new building or a renovation, with the basis of the rates stated, in the format lenders use.">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Construction or renovation estimate</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-300">Item by item, with the abstract of cost, the total and the cost per sq ft, in the format lenders use.</p>
  <div class="mt-2"><EstimateCalculator client:load /></div>
</Base>
