---
import Base from '../Base.astro';
import ToolHead from '../ToolHead.astro';
import { EstimateCalculator } from '../estimate/Estimate';
import { PlanEstimate } from '../estimate/PlanEstimate';
import { MORE, MoreName } from '../fields';
---
<Base name="Construction, renovation or interiors estimate" description="A new house, a renovation or interiors: six questions about your home, then every room, item and rate worked out as an architect would, at five levels, with a planning estimate to download for a lender." look="new">
  <div data-tool class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16 lg:max-w-6xl">
  <ToolHead href="/estimate/" kind="A cost estimate" title="Construction estimate" lead="The cost of a new house, a renovation or interiors: every room, item and rate, as PDF, Excel and Word." kept={false} />
  <div class="mt-2"><PlanEstimate client:load /></div>
  <details id="typed-path" class="mt-12">
    <summary class={MORE}><MoreName what="a contractor’s quotation, its items typed instead" /></summary>
    <div class="mt-2"><EstimateCalculator client:load /></div>
  </details>
  </div>
</Base>
