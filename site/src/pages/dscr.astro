---
import Base from '../Base.astro';
import ToolHead from '../ToolHead.astro';
import { DscrCalculator } from '../dscr/Calculator';
---
<Base name="DSCR statement" description="Year-wise DSCR, the average and the lowest year, and the loan or tenure that meets a lender’s target." look="new">
  <div data-tool class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16 lg:max-w-6xl">
  <ToolHead href="/dscr/" kind="A statement for your lender" title="DSCR statement" lead="Whether your business earns enough each year to repay the loan: the debt service coverage ratio (DSCR). A statement to sign, as PDF, Excel and Word. Seven questions to start." />
  <div class="mt-2"><DscrCalculator client:load /></div>
  </div>
</Base>
