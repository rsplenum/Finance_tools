---
import Base from '../Base.astro';
import { DscrCalculator } from '../dscr/Calculator';
---
<Base name="DSCR statement" description="Year-wise DSCR, the average and the lowest year, and the loan or tenure that meets a lender’s target.">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">DSCR statement</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-300">Year-wise DSCR, the average and the lowest year, and the loan or tenure that meets the lender’s target.</p>
  <div class="mt-2"><DscrCalculator client:load /></div>
</Base>
