---
import Base from '../Base.astro';
import { DscrCalculator } from '../dscr/Calculator';
---
<Base name="DSCR statement" description="Year-wise DSCR, the average and the lowest year, and the loan or tenure that meets a lender’s target." look="new">
  <div class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16">
  <h1 class="text-hero text-ink">DSCR statement</h1>
  <p class="mt-5 max-w-prose text-ink-muted">Year-wise DSCR, the average and the lowest year, and the loan or tenure that meets the lender’s target.</p>
  <div class="mt-2"><DscrCalculator client:load /></div>
  </div>
</Base>
