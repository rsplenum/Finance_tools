---
// Without a 404.html, Cloudflare Pages treats the site as a single-page app and answers every unknown path with the home page.
import Base from '../Base.astro';
const TOOLS = [['/dscr/', 'DSCR statement'], ['/cma/', 'CMA data'], ['/estimate/', 'Construction estimate'], ['/project-report/', 'Project report']];
---
<Base name="Page not found" description="This page does not exist." look="new">
  <h1 class="text-hero text-ink">Page not found</h1>
  <p class="mt-3 text-ink-muted">No page lives at this address. The tools are here:</p>
  <ul class="mt-4 space-y-2">
    {TOOLS.map(([href, name]) => <li><a href={href} class="inline-flex min-h-6 items-center text-link">{name}</a></li>)}
  </ul>
  <p class="mt-6" data-answer><a href="/" class="inline-flex min-h-6 items-center text-link">Go to the home page</a></p>
</Base>
