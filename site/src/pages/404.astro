---
// Without a 404.html, Cloudflare Pages treats the site as a single-page app and answers every unknown path with the home page.
import Base from '../Base.astro';
---
<Base name="Page not found" description="This page does not exist.">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Page not found</h1>
  <p class="mt-3"><a href="/" class="text-teal-700 underline underline-offset-4 dark:text-teal-400">Go to the home page</a></p>
</Base>
