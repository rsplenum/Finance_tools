---
import Base from '../Base.astro';
import { TOOLS } from '../site';
---
<Base description="DSCR statements, construction estimates and project reports in the format lenders expect, worked out in your browser.">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">Loan documents, right the first time</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-300">The statements lenders ask borrowers for, in the format they expect. For DSAs, accountants and borrowers.</p>
  <ul class="mt-8 space-y-3">
    {TOOLS.map((t) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="font-semibold text-slate-900 dark:text-slate-100">
            {t.href ? <a href={t.href} class="text-teal-700 underline underline-offset-4 dark:text-teal-400">{t.name}</a> : t.name}
          </h2>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">{t.status}</span>
        </div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{t.what}</p>
      </li>
    ))}
  </ul>
</Base>
