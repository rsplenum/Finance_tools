---
// The home page in the owner's pick from UX2b's looks (D-UX-64): A's quiet list (no boxes, a line between tools, the
// name as the link, what it gives under it) with C's whole-entry target and two columns from 640 px. The name's ::after
// covers its entry, so the whole entry is the target while the link's spoken name stays the tool's name alone.
import Base from '../Base.astro';
import { TOOLS } from '../site';
const ready = TOOLS.filter((t) => t.status === 'Ready' && t.href), later = TOOLS.filter((t) => t.status === 'Later');
---
<Base description="DSCR statements, construction estimates and project reports in the format lenders expect, worked out in your browser.">
  <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Loan documents lenders ask for</h1>
  <ul class="mt-6 grid sm:grid-cols-2 sm:gap-x-8" data-answer>
    {ready.map((t) => (
      <li class="group relative border-t border-line py-4">
        <h2 class="text-lg font-semibold"><a href={t.href} class="text-link underline underline-offset-4 group-hover:decoration-2 after:absolute after:inset-0">{t.name}</a></h2>
        <p class="mt-1 text-sm text-ink-muted">{t.what}</p>
      </li>
    ))}
  </ul>
  {later.map((t) => <p class="mt-4 max-w-prose text-sm text-ink-muted">Later: {t.name}. {t.what}</p>)}
</Base>
