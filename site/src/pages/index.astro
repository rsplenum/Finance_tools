---
/**
 * The home page in FinSight's own look (AG2, D-UX-68 to D-UX-72), rebuilt without repetition (HOME1b, D-UX-114,
 * D-UX-115): three sections, each saying what no other does. The hero: what the site gives, its two buttons and, under
 * them, how it works (How.astro: your answers, worked out on this device with nothing sent, four papers for the lender). The tools: each of the four
 * once, in one block with its name, what it gives, for whom, its five-beat scene in look C (Scene.astro; HOME1d, HOME1e,
 * D-UX-141), every figure the engine's and every document line the tool's own document's, from site/src/home/story.ts, and one button that opens it with that case. The closing desk, with one button. The motion
 * (site/src/home/home.ts, docs/DESIGN-MOTION.md) runs once, stops within 13 s (D-UX-125), and without scripts or under reduced motion
 * the page stands finished. FinSight's rules (docs/DESIGN.md) are held by scripts/forbidden-checks.mjs.
 */
import Base from '../Base.astro';
import How from '../home/How.astro';
import Scene from '../home/Scene.astro';
import { INTROS, SCENES } from '../home/story';

const WRAP = 'mx-auto max-w-7xl px-4 sm:px-8';
const INK = 'inline-flex min-h-11 items-center justify-center rounded-full bg-ink px-6 py-2.5 text-center font-medium text-canvas hover:bg-ink/85';
const SOFT = 'inline-flex min-h-11 items-center justify-center rounded-full bg-ink/5 px-6 py-2.5 font-medium text-ink hover:bg-ink/10';
// On the ink desk: a pill in paper.
const DESK = 'inline-flex min-h-11 items-center justify-center rounded-full bg-on-desk px-6 py-2.5 font-medium text-desk hover:bg-on-desk/85';
---
<Base look="new" description="DSCR statements, construction estimates, project reports and CMA data in the format lenders expect, worked out in your browser.">
  <section data-ag="hero">
    <div class={`${WRAP} flex flex-col items-center pt-16 pb-16 text-center sm:pt-28 sm:pb-24 lg:pt-36`}>
      <h1 class="max-w-5xl text-balance text-hero text-ink">Loan documents lenders ask for, worked out in your browser</h1>
      <p data-answer class="mt-6 max-w-lg text-lead text-ink-muted">A DSCR statement, a construction estimate, a project report and CMA data, in the format lenders expect.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/dscr/" class={INK}>Start a DSCR statement</a>
        <a href="#tools" class={SOFT}>See the four tools</a>
      </div>
      <How />
    </div>
  </section>

  <section id="tools" data-ag="tools" class={`${WRAP} space-y-20 py-16 sm:space-y-28 sm:py-24`}>
    {INTROS.map((i) => (
      <article data-tool={i.id} class="grid gap-8 lg:gap-12">
        <div class="grid gap-6 lg:grid-cols-5 lg:items-end lg:gap-12">
          <div class="lg:col-span-3">
            <h2 class="text-balance text-section text-ink">{i.name}</h2>
            <p class="mt-4 max-w-2xl text-lead text-ink">{i.gives}</p>
            <p class="mt-3 max-w-2xl text-lead text-ink-muted">{i.forWhom}</p>
          </div>
          <div class="lg:col-span-2 lg:justify-self-end"><a href={i.go.href} class={INK}>{i.go.text}</a></div>
        </div>
        <Scene scene={SCENES[i.id]} />
      </article>
    ))}
  </section>

  <section data-ag="closing" class="px-4 py-12 sm:px-8 sm:py-16">
    <div data-desk class="relative isolate mx-auto max-w-7xl overflow-hidden rounded-panel px-6 py-24 text-center sm:py-32">
      <canvas data-field="stage" aria-hidden="true" class="absolute inset-0 -z-10 size-full"></canvas>
      <h2 class="mx-auto max-w-4xl text-balance text-statement text-on-desk">Have the figures ready before you meet the lender</h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/dscr/" class={DESK}>Start a DSCR statement</a>
      </div>
    </div>
  </section>
</Base>
<script>import { start } from '../home/home'; start();</script>
