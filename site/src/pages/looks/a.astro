---
// UX2b, look A of three for the owner's pick on the preview (temporary; the pick moves into index.astro, then this goes).
// A plain list, GOV.UK's pattern: no boxes, a divider between tools, the name as the link, what it gives under it.
import Base from '../../Base.astro';
import { TOOLS } from '../../site';
const ready = TOOLS.filter((t) => t.status === 'Ready' && t.href), later = TOOLS.filter((t) => t.status === 'Later');
---
<Base name="Home, look A" description="DSCR statements, construction estimates and project reports in the format lenders expect, worked out in your browser.">
  <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Loan documents lenders ask for</h1>
  <p class="mt-3 max-w-prose text-ink-muted">Start with your question.</p>
  <ul class="mt-4 max-w-prose divide-y divide-line" data-answer>
    {ready.map((t) => (
      <li class="py-4">
        <h2 class="text-lg font-semibold"><a href={t.href} class="text-link underline underline-offset-4">{t.name}</a></h2>
        <p class="mt-1 max-w-prose text-sm text-ink-muted">{t.what}</p>
      </li>
    ))}
  </ul>
  {later.map((t) => <p class="mt-4 max-w-prose text-sm text-ink-muted">Later: {t.name}. {t.what}</p>)}
</Base>
