---
// UX2b, look B of three for the owner's pick on the preview (temporary; the pick moves into index.astro, then this goes).
// Questions first, built for the test task: each tool's question as the link, its name and what it gives under it.
import Base from '../../Base.astro';
import { TOOLS } from '../../site';
const ready = TOOLS.filter((t) => t.status === 'Ready' && t.href), later = TOOLS.filter((t) => t.status === 'Later');
---
<Base name="Home, look B" description="DSCR statements, construction estimates and project reports in the format lenders expect, worked out in your browser.">
  <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Loan documents lenders ask for</h1>
  <p class="mt-3 max-w-prose text-ink-muted">Start with your question.</p>
  <ul class="mt-6 max-w-prose space-y-6" data-answer>
    {ready.map((t) => (
      <li>
        <h2 class="text-lg font-semibold"><a href={t.href} class="text-link underline underline-offset-4">{t.ask ?? t.name}</a></h2>
        <p class="mt-1 text-sm text-ink">{t.name}</p>
        <p class="max-w-prose text-sm text-ink-muted">{t.what}</p>
      </li>
    ))}
  </ul>
  {later.map((t) => <p class="mt-8 max-w-prose text-sm text-ink-muted">Later: {t.name}. {t.what}</p>)}
</Base>
