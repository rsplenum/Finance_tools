---
// UX2b, look C of three for the owner's pick on the preview (temporary; the pick moves into index.astro, then this goes).
// Whole-card links, two by two from 640 px: the name is the link and its ::after covers the card, so the whole card is
// the target while the link's spoken name stays the tool's name alone.
import Base from '../../Base.astro';
import { TOOLS } from '../../site';
const ready = TOOLS.filter((t) => t.status === 'Ready' && t.href), later = TOOLS.filter((t) => t.status === 'Later');
---
<Base name="Home, look C" description="DSCR statements, construction estimates and project reports in the format lenders expect, worked out in your browser.">
  <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Loan documents lenders ask for</h1>
  <p class="mt-3 max-w-prose text-ink-muted">Start with your question.</p>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2" data-answer>
    {ready.map((t) => (
      <li class="relative rounded-card border border-edge p-4 hover:bg-surface">
        <h2 class="text-lg font-semibold"><a href={t.href} class="text-link underline underline-offset-4 after:absolute after:inset-0 after:rounded-card">{t.name}</a></h2>
        <p class="mt-1 text-sm text-ink-muted">{t.what}</p>
      </li>
    ))}
  </ul>
  {later.map((t) => <p class="mt-6 max-w-prose text-sm text-ink-muted">Later: {t.name}. {t.what}</p>)}
</Base>
