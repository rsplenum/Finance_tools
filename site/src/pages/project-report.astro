---
import Base from '../Base.astro';
import { ReportCalculator } from '../report/Report';
---
<Base name="Project report" description="A project report for a term loan with working capital: cost and finance, projected profit and loss, balance sheet and cash flow, DSCR, break-even and ratios." look="new">
  <div class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16">
  <h1 class="text-hero text-ink">Project report</h1>
  <p class="mt-5 max-w-prose text-ink-muted">For a term loan with working capital: the cost of the project and its finance, the projected profit and loss, balance sheet and cash flow, the DSCR, break-even and the usual ratios.</p>
  <div class="mt-2"><ReportCalculator client:load /></div>
  </div>
</Base>
