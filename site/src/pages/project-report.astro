---
import Base from '../Base.astro';
import { ReportCalculator } from '../report/Report';
---
<Base name="Project report" description="A project report for a term loan with working capital: cost and finance, projected profit and loss, balance sheet and cash flow, DSCR, break-even and ratios.">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Project report</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-300">For a term loan with working capital: the cost of the project and its finance, the projected profit and loss, balance sheet and cash flow, the DSCR, break-even and the usual ratios.</p>
  <div class="mt-2"><ReportCalculator client:load /></div>
</Base>
