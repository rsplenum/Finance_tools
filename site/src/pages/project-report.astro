---
import Base from '../Base.astro';
import ToolHead from '../ToolHead.astro';
import { ReportCalculator } from '../report/Report';
---
<Base name="Project report" description="A project report for a term loan with working capital: cost and finance, projected profit and loss, balance sheet and cash flow, DSCR, break-even and ratios." look="new">
  <div data-tool class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-8 sm:pt-16 lg:max-w-6xl">
  <ToolHead href="/project-report/" kind="A report for a new term loan" title="Project report" lead="Projected accounts, yearly repayment, break-even and the ratios a lender checks, as PDF, Excel and Word. Keep the project’s cost, its finance and your expected sales at hand." />
  <div class="mt-2"><ReportCalculator client:load /></div>
  </div>
</Base>
