// API Worker (D-TECH-01): a health route, POST /read (U1, D-UX-48) and POST /e (UD1, D-TECH-37) with its nightly prune. Razorpay orders, webhook checks and download tokens come later.
// The D1 and KV IDs are the owner's (DEP1, 19-10-2026, docs/CLOUDFLARE.md §2); IDs are not secrets.
// Secrets never go in this file: use `wrangler secret put` or the dashboard.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "finance-tools-api",
  "main": "src/index.ts",
  // Not later than the runtime bundled with the pinned wrangler (workerd 1.20260926).
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  // Invocation logs are off: they would keep each request's headers, an IP among them (D-TECH-37). Errors still log.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // UD1: rows of interaction data older than 400 days are deleted at 03:17 UTC each night.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "finance-tools", "database_id": "42dfe36d-8685-411e-9cda-56d94cbef42d", "migrations_dir": "migrations" }
  ],
  // Reading statements (D-UX-48): the model, its effort (empty for a model without one), reads per address and in all
  // per day (the owner pays for each), and the site origins allowed to call from another host (POST /e takes batches only from these too) ("." starts a subdomain suffix; never ".pages.dev", which admits anyone's site).
  // Drafting the report's words (REP2, D-AI-02): the model, its effort, drafts per address and in all per day, apart from reads.
  // The ANTHROPIC_API_KEY is a secret: `wrangler secret put ANTHROPIC_API_KEY`. Without it /read and /draft answer 503.
  "vars": {
    "READ_MODEL": "claude-opus-5-5",
    "READ_EFFORT": "medium",
    "READ_PER_IP": "10",
    "READ_PER_DAY": "50",
    "DRAFT_MODEL": "claude-opus-5-5",
    "DRAFT_EFFORT": "low",
    "DRAFT_PER_IP": "3",
    "DRAFT_PER_DAY": "50",
    "READ_ORIGINS": "https://finance-tools-9if.pages.dev,.finance-tools-9if.pages.dev"
  },
  // SEC1 (D-TECH-54): POST /e takes at most 30 batches a minute from one address (a visit sends one about every 20
  // seconds), counted in Cloudflare's memory, never stored. The namespace_id is any number unique to this account.
  "ratelimits": [
    { "name": "EVENTS_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "d4417d17a31043da9e0c00fb021db4e2" }
  ]
}
