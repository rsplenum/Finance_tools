// API Worker (D-TECH-01): a health route and POST /read (U1, D-UX-48). Razorpay orders, webhook checks and download tokens come later.
// The two IDs are placeholders. Create the D1 database and the KV namespace in the Cloudflare dashboard and put their
// IDs here (IDs are not secrets). Secrets never go in this file: use `wrangler secret put` or the dashboard.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "finance-tools-api",
  "main": "src/index.ts",
  // Not later than the runtime bundled with the pinned wrangler (workerd 1.20260926).
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "finance-tools", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Reading statements (D-UX-48): the model, its effort (empty for a model without one), reads per address and in all
  // per day (the owner pays for each), and the site origins allowed to call from another host ("." starts a subdomain suffix; never ".pages.dev", which admits anyone's site).
  // The ANTHROPIC_API_KEY is a secret: `wrangler secret put ANTHROPIC_API_KEY`. Without it /read answers 503.
  "vars": {
    "READ_MODEL": "claude-opus-5-5",
    "READ_EFFORT": "medium",
    "READ_PER_IP": "10",
    "READ_PER_DAY": "50",
    "READ_ORIGINS": "https://finance-tools-9if.pages.dev,.finance-tools-9if.pages.dev"
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ]
}
